diff --git a/plugin/ui/services/Tone3000Session.cpp b/plugin/ui/services/Tone3000Session.cpp
index afe4819..229aa58 100644
--- a/plugin/ui/services/Tone3000Session.cpp
+++ b/plugin/ui/services/Tone3000Session.cpp
@@ -253,18 +253,15 @@ void Tone3000Session::login(LoginIntent intent) {
     return;
   }
   lastIntent_ = intent;
-  if (config_.signInViaApp) {
-    // The app may have signed in since this editor last looked: then the
-    // gated action simply goes ahead. Otherwise there is no browser to
-    // send anywhere: the device code is the sign-in, the screen opens on
-    // it, and the app's sign-in is watched for alongside.
-    if (adoptAppSignIn()) return;
+  if (config_.signInViaApp || config_.preferDeviceCode) {
+    if (config_.signInViaApp && adoptAppSignIn()) return;
     stopDeviceFlow();
     flow_ = {};
-    flow_.deviceOnly = true;
+    flow_.deviceOnly = config_.signInViaApp;
     setFlow(AuthFlow::Phase::leaving);
     startDeviceFlow();
-    appSignInPoll_.start(kAppSignInPollMs, [this] { pollAppSignIn(); });
+    if (config_.signInViaApp)
+      appSignInPoll_.start(kAppSignInPollMs, [this] { pollAppSignIn(); });
     return;
   }
   stopDeviceFlow();
